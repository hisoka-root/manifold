{
  "multipart": [
    {
      "apply": {
        "model": "manifold:block/pipe_core_requester"
      }
    },
    {
      "apply": {
        "model": "manifold:block/pipe_cap_requester"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "manifold:block/pipe_cap_requester",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "manifold:block/pipe_cap_requester",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "manifold:block/pipe_cap_requester",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "manifold:block/pipe_cap_requester",
        "x": 270
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "manifold:block/pipe_cap_requester",
        "x": 90
      },
      "when": {
        "down": "true"
      }
    }
  ]
}